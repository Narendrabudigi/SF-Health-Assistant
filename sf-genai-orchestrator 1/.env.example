# Copy to .env and fill in. NEVER commit .env.
# On SAP BTP / Cloud Foundry set these as app environment variables (or a
# user-provided service) and ship no .env file; real environment variables
# always take precedence over .env.

LOG_LEVEL=INFO

# Supabase (server side only: the secret / service-role key bypasses the security rules, never put it in the website).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# The tables of the industry standards (names are case-sensitive and must match exactly).
# INSIGHTS_TABLE: where the ML notebooks write their insights. The rows created on the run date (UTC) are that run's insights.
# REPORTS_TABLE: where the reports are saved, one row per metric (create it with sql/llm_reports.sql).
INSIGHTS_TABLE=ML_Notebook_Insights
REPORTS_TABLE=LLM_Reports

# A healthy metric gets a short summary (one or two paragraphs) of how well it is doing. Set to false to skip healthy metrics.
# HEALTHY_SUMMARIES=true

# A metric the notebook could not calculate because MANDATORY fields are missing (it names them under
# missingConfigurations.mandatoryFieldsMissing) gets a plan to set those fields up. Set to false to skip such metrics.
# SETUP_REPORTS=true

# The ML notebooks that sf-pipeline runs before the LLM step (all optional; defaults shown).
# NOTEBOOKS_DIR=notebooks             # folder with the notebooks: every .py file in it is run
# NOTEBOOK_TIMEOUT_MINUTES=60         # a notebook that runs longer is stopped and counted as failed
# NOTEBOOK_CONCURRENCY=1              # how many notebooks run at the same time
# NOTEBOOK_PYTHON=                    # path of another Python (for example your ML environment) if the notebooks need other packages
# LOGS_DIR=logs                       # what each notebook prints is kept in logs/<run-date>/<notebook>.log

# Custom standards: the company's own benchmarks (an xlsx file the client uploads) instead of the industry ones. They have their own
# notebooks folder, their own insights table (written by the custom notebooks) and their own reports table (create it with
# sql/llm_reports_custom.sql). Leave the two tables out and sf-pipeline simply runs the industry standards only.
CUSTOM_INSIGHTS_TABLE=ML_Notebook_Custom_Insights
CUSTOM_REPORTS_TABLE=LLM_Reports_Custom
# The file in the bucket (the custom notebooks read the same variable):
# CUSTOM_STANDARDS_FILE_PATH=SF Health Monitoring Custom Standards.xlsx
# CUSTOM_STANDARDS_BUCKET=SF_Health_Raw_Data
# Every .py file in this folder is a custom notebook; start its name with the module (EC ..., RCM ...):
# CUSTOM_NOTEBOOKS_DIR=notebooks_custom

# DASHBOARD_TRACKING=true

# API keys: one per vendor, shared by that vendor's models.
GEMINI_API_KEY=
GROQ_API_KEY=

# LLM failover chain, tried in this order (LiteLLM model strings: gemini/<id> or groq/<id>).
# LiteLLM moves to the next entry on quota/token exhaustion, rate limits, timeouts, 5xx, bad key, etc.
#   1 gemini-3.8-flash      newest stable Gemini; strongest reasoning for the diagnosis and action plan
#   2 gemini-3.7-flash      previous stable Gemini; separate quota bucket from the primary
#   3 openai/gpt-oss-120b   strongest production model on Groq; JSON output; 131K context, 65K max output
#   4 openai/gpt-oss-20b    faster, cheaper Groq backup; separate rate limits from the 120B
LLM_CHAIN=gemini/gemini-3.8-flash,gemini/gemini-3.7-flash,groq/openai/gpt-oss-120b,groq/openai/gpt-oss-20b
# How much the model may "think" before it answers. Thinking is billed as output tokens: minimal, low, medium, high, disable,
# or empty for the model's own default.
LLM_REASONING_EFFORT=low
# Optional tuning (defaults shown)
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=16384         # includes the model's reasoning tokens
# LLM_TIMEOUT_SECONDS=90
# LLM_NUM_RETRIES=2             # retries on the SAME model for 503 "high demand", 5xx and timeouts
# LLM_RATE_LIMIT_RETRIES=1     # for a 429: wait as long as the provider asks (up to 60 s), then retry once
# LLM_RETRY_WAIT_SECONDS=10    # minimum wait between retries of the same model (max 60)
# LLM_ALLOWED_FAILS=2          # failures per minute before a model is put on cooldown
# LLM_COOLDOWN_SECONDS=120     # a model that keeps failing is skipped this long, then tried again
# LLM_REPAIR_ATTEMPTS=1        # re-asks when the model's JSON fails validation
# ORCHESTRATOR_CONCURRENCY=1   # metrics processed at the same time (1 keeps Groq's tokens-per-minute limit in check)